# Default app: CKB public Testnet, using a connected wallet. No private keys.
VITE_CHAIN=testnet
VITE_TESTNET_RPC_URL=https://testnet.ckb.dev/

# Optional local Devnet: run pnpm configure to discover deployments/accounts.
# Public, disposable OffCKB Devnet accounts ONLY. Every VITE variable is public.
# Run pnpm configure to discover the local chain, deployment and built-in accounts.
# VITE_CHAIN=devnet
VITE_RPC_URL=http://127.0.0.1:28114
VITE_EXPECTED_GENESIS_HASH=
VITE_CHAIN_CONFIG=
VITE_DEMO_KEY_A=
VITE_DEMO_KEY_B=
